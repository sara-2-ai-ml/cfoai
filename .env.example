# --- Ports (local dev) ---
# CFOai (Next.js): open the URL shown in terminal as "Local:" — usually http://localhost:3000
# CHROMA_URL must match your Chroma server (local Docker default below).
# Start Chroma + Next together: npm run dev:full  (requires Docker)

# Anthropic (chat / summary / compare / GraphRAG entity extraction)
ANTHROPIC_API_KEY=
# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (embeddings, charts)
OPENAI_API_KEY=

# ChromaDB
CHROMA_URL=http://localhost:8000
# Optional — when using Chroma Cloud or secured instance
CHROMA_API_KEY=
CHROMA_TENANT=

# Neo4j — GraphRAG (knowledge graph storage + retrieval)
# Create free instance: https://neo4j.com/cloud/platform/aura-graph/
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional — Neo4j Aura database name
NEO4J_DATABASE=neo4j

# Vercel Blob (optional file storage; not required for local upload flow)
BLOB_READ_WRITE_TOKEN=

# Next.js 15 — keep stable across `next dev` / rebuilds so Server Action IDs match the client.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
